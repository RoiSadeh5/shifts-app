rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin UID – replace with your UID from Firebase Console → Authentication → Users
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_YOUR_UID';
    }
    // Helper: user owns this resource
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    // User data: owner can read/write; admin can read/write all
    match /users/{userId} {
      allow read, write: if isAdmin() || isOwner(userId);
      match /data/{doc} {
        allow read, write: if isAdmin() || isOwner(userId);
      }
      match /templates/{templateId} {
        allow read, write: if isAdmin() || isOwner(userId);
      }
    }
  }
}
